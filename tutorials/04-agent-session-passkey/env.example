# Copy to .env.local

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Chipi (dashboard.chipipay.com). Register Clerk's JWKS in the Chipi dashboard.
NEXT_PUBLIC_CHIPI_API_KEY=pk_prod_...
CHIPI_API_SECRET_KEY=sk_prod_...

# Encrypts the agent's session keys at rest. Long and random; never shipped to the browser.
# openssl rand -hex 32
AGENT_SESSION_SECRET=
