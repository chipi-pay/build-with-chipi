# Copy to .env.local

# Where the app is served from, over https. The passkey is bound to this
# hostname, and Chipi must reach ${APP_URL}/api/auth/jwks. In development use a
# tunnel, e.g.
#   cloudflared tunnel --url http://localhost:3000
APP_URL=https://your-app.example.com

# Signs the session cookie. Never shipped to the browser.
# openssl rand -hex 32
APP_SECRET=

# RSA key that signs the JWTs Chipi checks (one key, RS256). Base64 of a PKCS#8 PEM:
# node -e "const {generateKeyPairSync}=require('node:crypto');console.log(Buffer.from(generateKeyPairSync('rsa',{modulusLength:2048}).privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
APP_JWT_PRIVATE_KEY=

# Chipi (dashboard.chipipay.com). Register ${APP_URL}/api/auth/jwks as the JWKS endpoint.
# Only the public key: every Chipi call in this tutorial runs in the browser with the user's JWT.
NEXT_PUBLIC_CHIPI_API_KEY=pk_prod_...

# Optional: your own RPCs (defaults: Cartridge's public Starknet endpoint, Base's public endpoint).
NEXT_PUBLIC_STARKNET_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=
